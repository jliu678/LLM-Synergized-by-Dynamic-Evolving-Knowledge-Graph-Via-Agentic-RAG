# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/primekg_rag
# Example for Neon: postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb

# Neo4j Configuration for Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# LLM Provider Configuration
# Set this to either openai, openrouter, ollama, or gemini
LLM_PROVIDER=openai

# Base URL for the LLM provider
# OpenAI: https://api.openai.com/v1
# Ollama (example): http://localhost:11434/v1
# OpenRouter: https://openrouter.ai/api/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta
LLM_BASE_URL=https://api.openai.com/v1

# API Key for LLM provider
# OpenAI: Get from https://platform.openai.com/api-keys
# OpenRouter: Get from https://openrouter.ai/keys
# Ollama: Use "ollama" (no key needed)
# Gemini: Get from Google AI Studio
LLM_API_KEY=sk-your-api-key-here

# The LLM you want to use for the agents. Make sure this LLM supports tools!
# OpenAI example: gpt-4o-mini
# OpenRouter example: anthropic/claude-3-5-sonnet
# Ollama example: qwen2.5:14b-instruct
# Gemini example: gemini-2.0-flash-exp
LLM_CHOICE=gpt-4o-mini

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DIMENSION=1024
# EMBEDDING_BASE_URL and API_KEY not needed for local providerembedding-3-small

# Ingestion-specific LLM (can be different/faster model for processing)
# Leave empty to use the same as LLM_CHOICE
INGESTION_LLM_CHOICE=gpt-4o-mini

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8058

# PrimeKG Data Configuration
PRIMEKG_DATA_DIR=./data
PRIMEKG_DOWNLOAD_URL=https://dataverse.harvard.edu/api/access/datafile/6180620

# Vector Search Configuration
VECTOR_DIMENSION=1536  # For OpenAI text-embedding-3-small (change to 768 for nomic-embed-text)
MAX_SEARCH_RESULTS=10

# Graphiti Configuration
GRAPHITI_BATCH_SIZE=3
GRAPHITI_MAX_TOKENS=7000

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_SESSION=100

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Debug Configuration
DEBUG_MODE=false
ENABLE_PROFILING=false
